{
  "format": "tosampool-agent-effect-manifest",
  "version": 1,
  "lifecycle": "experimental-runtime-partial",
  "source": "editor/effect-registry-vnext.js",
  "pipelines": {
    "object": {
      "compose": "compose",
      "defaultOrder": [
        "mask",
        "decorate",
        "sample"
      ],
      "movableStages": [
        "mask",
        "decorate",
        "sample"
      ],
      "stages": {
        "compose": "成样",
        "mask": "蒙版",
        "decorate": "加样",
        "sample": "采样"
      },
      "summary": "成样固定在首位；蒙版、加样、采样可整体调序，组内效果顺序固定。"
    },
    "scene": {
      "order": [
        "overlay",
        "sample"
      ],
      "stages": {
        "overlay": "场景叠加滤镜",
        "sample": "场景采样滤镜"
      },
      "summary": "所有对象合成后依次进行场景叠加与场景采样；噪点属于叠加图案，不再拥有独立输出阶段。"
    }
  },
  "controllers": [
    {
      "id": "sampling-grid",
      "name": "采样格",
      "aliases": [],
      "family": "sample-controller",
      "scopes": [
        "object",
        "scene"
      ],
      "purpose": "当前对象或场景的独立最近邻再采样；同时为偏移、网点与不均采样提供共同的低分辨率工作面。",
      "avoidWhen": [],
      "timing": "step",
      "particleBake": "shared-frame",
      "cost": "A",
      "parameters": [
        {
          "key": "size",
          "label": "采样尺寸",
          "type": "number",
          "default": 1,
          "min": 1,
          "max": 128
        }
      ]
    }
  ],
  "effects": [
