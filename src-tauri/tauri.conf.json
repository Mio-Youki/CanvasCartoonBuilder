{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Patcharium",
  "version": "3.0.0",
  "identifier": "com.mioyouki.patcharium",
  "build": {
    "beforeDevCommand": "node scripts/prepare-tauri-frontend.mjs",
    "beforeBuildCommand": "node scripts/prepare-tauri-frontend.mjs",
    "frontendDist": "../.tauri-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Patcharium / 拼好景",
        "url": "img2asset-layout-v1.html",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' data: blob: asset: http://asset.localhost; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
